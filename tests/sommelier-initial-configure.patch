+void sl_host_surface_attach_pending_buffer(struct sl_host_surface* host) {
+  if (!host->pending_buffer_attach)
+    return;
+  wl_surface_attach(host->proxy, host->pending_buffer,
+                    host->contents_x_offset, host->contents_y_offset);
+  host->pending_buffer_attach = false;
